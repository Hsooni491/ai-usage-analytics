{
  "datasets": [
    {
      "name": "ds_users",
      "displayName": "Survey respondents (gold.fct_ai_usage)",
      "queryLines": [
        "SELECT user_id, user_type, gender, country, age_group, education_level, profession_category,\n",
        "       ai_tool, ai_purpose, usage_band, plan_tier, income_band,\n",
        "       productivity_score, satisfaction_score, accuracy_rating,\n",
        "       time_saved_hours_per_week, ai_usage_hours_per_day, monthly_ai_cost,\n",
        "       is_paid_user, is_promoter, is_detractor\n",
        "FROM fct_ai_usage\n"
      ],
      "columns": [
        {
          "displayName": "Respondents",
          "description": "Number of survey respondents",
          "expression": "COUNT(`user_id`)"
        },
        {
          "displayName": "Avg Productivity",
          "description": "Average self-rated productivity (0-10)",
          "expression": "AVG(`productivity_score`)"
        },
        {
          "displayName": "Avg Satisfaction",
          "description": "Average satisfaction with the AI tool (1-10)",
          "expression": "AVG(`satisfaction_score`)"
        },
        {
          "displayName": "Avg Hours Saved",
          "description": "Average hours saved per week",
          "expression": "AVG(`time_saved_hours_per_week`)"
        },
        {
          "displayName": "Recommend Rate",
          "description": "Share of respondents who would recommend their tool",
          "expression": "SUM(`is_promoter`) * 1.0 / COUNT(`user_id`)"
        },
        {
          "displayName": "Net Recommend Score",
          "description": "% would recommend minus % would not (range -100 to +100)",
          "expression": "(SUM(`is_promoter`) - SUM(`is_detractor`)) * 100.0 / COUNT(`user_id`)"
        },
        {
          "displayName": "Paid Share",
          "description": "Share of respondents paying for AI",
          "expression": "SUM(`is_paid_user`) * 1.0 / COUNT(`user_id`)"
        }
      ]
    },
    {
      "name": "ds_tools",
      "displayName": "Respondents who named their AI tool",
      "queryLines": [
        "SELECT user_id, user_type, gender, country, age_group, education_level, profession_category,\n",
        "       ai_tool, ai_purpose, usage_band, plan_tier, income_band,\n",
        "       productivity_score, satisfaction_score, accuracy_rating,\n",
        "       time_saved_hours_per_week, ai_usage_hours_per_day, monthly_ai_cost,\n",
        "       is_paid_user, is_promoter, is_detractor\n",
        "FROM fct_ai_usage\n",
        "WHERE ai_tool <> 'Unknown'\n"
      ],
      "columns": [
        {
          "displayName": "Respondents",
          "description": "Number of survey respondents",
          "expression": "COUNT(`user_id`)"
        },
        {
          "displayName": "Avg Productivity",
          "description": "Average self-rated productivity (0-10)",
          "expression": "AVG(`productivity_score`)"
        },
        {
          "displayName": "Avg Satisfaction",
          "description": "Average satisfaction with the AI tool (1-10)",
          "expression": "AVG(`satisfaction_score`)"
        },
        {
          "displayName": "Avg Hours Saved",
          "description": "Average hours saved per week",
          "expression": "AVG(`time_saved_hours_per_week`)"
        },
        {
          "displayName": "Recommend Rate",
          "description": "Share of respondents who would recommend their tool",
          "expression": "SUM(`is_promoter`) * 1.0 / COUNT(`user_id`)"
        },
        {
          "displayName": "Net Recommend Score",
          "description": "% would recommend minus % would not (range -100 to +100)",
          "expression": "(SUM(`is_promoter`) - SUM(`is_detractor`)) * 100.0 / COUNT(`user_id`)"
        },
        {
          "displayName": "Paid Share",
          "description": "Share of respondents paying for AI",
          "expression": "SUM(`is_paid_user`) * 1.0 / COUNT(`user_id`)"
        }
      ]
    },
    {
      "name": "ds_corr",
      "displayName": "Metric correlations (gold.mart_metric_correlations)",
      "queryLines": [
        "SELECT regexp_replace(initcap(replace(metric_x, '_', ' ')), '^Ai ', 'AI ') AS metric_x, regexp_replace(initcap(replace(metric_y, '_', ' ')), '^Ai ', 'AI ') AS metric_y, pearson_r\n",
        "FROM mart_metric_correlations\n"
      ]
    },
    {
      "name": "ds_dq",
      "displayName": "Data quality checks (gold.mart_data_quality)",
      "queryLines": [
        "SELECT regexp_replace(initcap(replace(check_name, '_', ' ')), '^Ai ', 'AI ') AS check_name, regexp_replace(initcap(replace(check_type, '_', ' ')), '^Ai ', 'AI ') AS check_type, affected_rows, total_rows\n",
        "FROM mart_data_quality\n",
        "ORDER BY affected_rows DESC\n"
      ]
    }
  ],
